# npm
node_modules/

# android build output — regenerated by gradle, never edited by hand
android/.gradle/
android/build/
android/app/build/
android/local.properties
android/.idea/
android/captures/
android/*.iml

# capacitor copies the web folder in on every sync; the source of truth is
# hifz-<version>/, so the copy inside the app does not belong in history
android/app/src/main/assets/public/
android/app/src/main/assets/capacitor.config.json

# server-side store written by sync.php at runtime
release/sync-data/
hifz-*/sync-data/

# keystores and anything that signs a release must never be committed
*.keystore
*.jks
keystore.properties
