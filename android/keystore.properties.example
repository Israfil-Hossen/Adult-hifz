# Copy this file to android/keystore.properties and fill in your own values.
# That copy is gitignored — the real one must never be committed.
#
# Create the keystore first (run it yourself; it asks for passwords):
#   keytool -genkeypair -v -keystore adult-hifz.jks -keyalg RSA \
#           -keysize 2048 -validity 10000 -alias adulthifz
#
# storeFile is relative to the android/app/ folder, or an absolute path.
# Keeping the .jks OUTSIDE the repo entirely is the safest choice.

storeFile=../../adult-hifz.jks
storePassword=CHANGE_ME
keyAlias=adulthifz
keyPassword=CHANGE_ME
